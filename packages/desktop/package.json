{
  "name": "@cocode/desktop",
  "version": "1.0.0",
  "type": "module",
  "description": "CoCode 桌面版（Electron 壳：启动本地 ASAPI 服务并托管 agentscope 风格前端）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:ui": "cd frontend && npm run build",
    "dist:mac": "npm run build:ui && electron-builder --mac dmg zip --universal --publish never",
    "dist:win": "npm run build:ui && electron-builder --win nsis --x64 --publish never",
    "release:mac": "npm run build:ui && electron-builder --mac dmg zip --universal --publish always",
    "release:win": "npm run build:ui && electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.cocode.desktop",
    "productName": "CoCode",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!frontend/node_modules/**",
      "!frontend/src/**",
      "!frontend/package-lock.json"
    ],
    "extraResources": [
      {
        "from": "../core",
        "to": "core"
      },
      {
        "from": "frontend/dist",
        "to": "desktop/frontend/dist"
      }
    ],
    "mac": {
      "artifactName": "${productName}-${version}-mac.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "CoCodeAgent",
      "repo": "CoCode",
      "releaseType": "release"
    }
  }
}
